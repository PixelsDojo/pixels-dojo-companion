# HTTP server port
PORT=3000

# URL of the self-hosted Ollama instance.
# When running in the combined container (Dockerfile), Ollama runs alongside
# the Node server, so this stays as localhost.
OLLAMA_URL=http://localhost:11434

# Ollama model to use for answering questions
OLLAMA_MODEL=qwen2.5:3b

# Directory where Ollama stores downloaded model weights.
# In the Railway container this should point inside the mounted Volume
# (e.g. mount the Volume at /app/data — both the SQLite DB and model weights
# live there, matching the /app/data/ convention used across Railway services).
OLLAMA_MODELS=/app/data/ollama-models

# Path to the SQLite database file (also inside the Railway Volume)
DATABASE_PATH=/app/data/pixels-assistant.db

# Base URL of the Pixels server used by the background land crawler.
# The crawler hits GET /infiniportal/farm_details/:farmId — no auth required.
# Set this to the production server URL in Railway env vars.
PIXELS_SERVER_URL=https://server.pixels.xyz

# Secret key that gates all /debug/* endpoints.
# If unset, ALL debug routes return 403 (disabled).
# Set to a long random string in production.
DEBUG_KEY=
